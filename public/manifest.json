{
  "name": "Nova Spain Selfie",
  "version": "2.0.1",
  "manifest_version": 3,
  "description": "Verify Liveness spain port",
  "author": {
    "name": "NOVA",
    "email": "NOVA"
  },
  "action": {
    "default_title": "Bypass"
  },
  "background": {
    "service_worker": "/js/background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "gcm",
    "tts",
    "privacy",
    "storage",
    "activeTab",
    "proxy",
    "browsingData",
    "webNavigation",
    "notifications",
    "webRequest",
    "webRequestAuthProvider",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "scripting",
    "cookies",
    "management",
    "tabCapture"
  ],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/jquery.min.js",
        "assets/bootstrap.min.css",
        "routes/verifyLiveness.html",
        "js/vf.js",
        "js/novabls_handler.js",
        "js/background.js",
        "js/_fetch.js"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "novabls_redirect",
        "enabled": true,
        "path": "novabls.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "/images/icon.png",
    "32": "/images/icon.png",
    "48": "/images/icon.png"
  }
}
